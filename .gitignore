# Python bytecode caches (DevKit test imports create tools/__pycache__).
__pycache__/

# Lia dev-only QA outputs (Phase 7.9D smoke WAVs, staging homes). Never commit:
# no models, no runtimes, no audio artifacts live in Git.
.devkit-qa/

# Lia QA harness generated content (Phase 7.9G-QA). Run folders carry isolated
# runtimes, downloaded models, logs and metrics - none of it belongs in Git.
# Only Tests/README.md and Tests/tools are committed.
Tests/runs/
Tests/runtimes/
Tests/logs/
Tests/inventory/
Tests/tmp/
Tests/artifacts/

# Workspace tooling may create a root cache; dependencies are never source.
/node_modules/
/airi/apps/stage-tamagotchi/Tests/artifacts/

# Bancada STT (tools/stt-bench). Ambiente, saida e audio nunca entram no Git.
# O manifesto samples.json e pessoal; o exemplo versionado e samples.example.json.
tools/stt-bench/.venv/
tools/stt-bench/out/
tools/stt-bench/samples.json
tools/stt-bench/samples/*.wav
tools/stt-bench/samples/*.mp3
tools/stt-bench/samples/*.flac
tools/stt-bench/samples/*.m4a
tools/stt-bench/samples/*.ogg
tools/stt-bench/samples/*.opus
tools/stt-bench/samples/*.webm
