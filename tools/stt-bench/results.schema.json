{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BloomRX/Lia-Project/tools/stt-bench/results.schema.json",
  "title": "Resultado da bancada STT da Lia",
  "description": "Saída de stt_bench.py. Um resultado descreve UMA execução em UM ambiente. Não é transferível entre máquinas. status=error nunca promove.",
  "type": "object",
  "required": [
    "schema",
    "status",
    "runId",
    "generatedAt",
    "environment",
    "plumbingOnly",
    "machine",
    "runtime",
    "weights",
    "dataset",
    "summary",
    "samples",
    "verdict",
    "verdictReasons",
    "catalogPromotion",
    "warnings",
    "limits"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "lia.stt-bench.result/v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string",
      "enum": [
        "arena-linux",
        "windows-reference-machine",
        "windows-other",
        "macos-other",
        "linux-other"
      ],
      "description": "Classificado por detecção. Nenhum resultado Linux vale como medição da máquina de referência."
    },
    "plumbingOnly": {
      "type": "boolean",
      "description": "true quando veio de --self-test: valida o encanamento, não a qualidade."
    },
    "machine": {
      "type": "object",
      "required": [
        "os",
        "architecture",
        "cpuName",
        "totalRamBytes",
        "gpuName"
      ],
      "additionalProperties": true,
      "properties": {
        "os": {
          "type": "string"
        },
        "osRelease": {
          "type": "string"
        },
        "osVersion": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "cpuName": {
          "type": "string"
        },
        "cpuCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "totalRamBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "totalRamGib": {
          "type": [
            "number",
            "null"
          ]
        },
        "gpuName": {
          "type": "string"
        },
        "referenceSignals": {
          "type": "object"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "id",
        "backend",
        "computeType",
        "language",
        "dependencies"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "const": "faster-whisper"
        },
        "backend": {
          "const": "cpu"
        },
        "computeType": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "beamSize": {
          "type": "integer",
          "minimum": 1
        },
        "vadFilter": {
          "type": "boolean"
        },
        "cpuThreads": {
          "type": "integer",
          "minimum": 0
        },
        "python": {
          "type": "string"
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "weights": {
      "type": "object",
      "required": [
        "modelId",
        "revision",
        "declaredLicense",
        "present"
      ],
      "additionalProperties": true,
      "properties": {
        "modelId": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "revisionMatch": {
          "type": "boolean"
        },
        "declaredLicense": {
          "type": "string"
        },
        "declaredSource": {
          "type": "string"
        },
        "declaredCheckedAt": {
          "type": "string"
        },
        "cacheRoot": {
          "type": [
            "string",
            "null"
          ]
        },
        "cacheDir": {
          "type": [
            "string",
            "null"
          ]
        },
        "present": {
          "type": "boolean"
        },
        "integrityOk": {
          "type": "boolean"
        },
        "usable": {
          "type": "boolean"
        },
        "hashChecked": {
          "type": "boolean"
        },
        "files": {
          "type": "array"
        },
        "incompleteDownloads": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "required": [
        "datasetId",
        "license",
        "sampleCount",
        "totalBytes"
      ],
      "additionalProperties": true,
      "properties": {
        "datasetId": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        },
        "totalMb": {
          "type": "number"
        },
        "withReference": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "sampleCount",
        "totalAudioSec"
      ],
      "additionalProperties": true,
      "properties": {
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "samplesWithReference": {
          "type": "integer",
          "minimum": 0
        },
        "totalAudioSec": {
          "type": "number",
          "minimum": 0
        },
        "meanAudioSec": {
          "type": [
            "number",
            "null"
          ]
        },
        "downloadMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "modelLoadMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "firstTranscribeMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "transcribeMsMedian": {
          "type": [
            "number",
            "null"
          ]
        },
        "transcribeMsP95": {
          "type": [
            "number",
            "null"
          ]
        },
        "rtfMedian": {
          "type": [
            "number",
            "null"
          ]
        },
        "rtfP95": {
          "type": [
            "number",
            "null"
          ]
        },
        "memoryBeforeLoad": {
          "type": [
            "object",
            "null"
          ]
        },
        "memoryAfterLoad": {
          "type": [
            "object",
            "null"
          ]
        },
        "memoryAfterLastSample": {
          "type": [
            "object",
            "null"
          ]
        },
        "peakRssBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "peakRssMib": {
          "type": [
            "number",
            "null"
          ],
          "description": "Pico de RSS em MiB (1024^2). Nao confundir com MB decimal."
        },
        "peakScope": {
          "type": "string"
        },
        "corpusWer": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "corpusWerAccentInsensitive": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "corpusCer": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "exactMatchRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "bytes",
          "transcribeMs",
          "hypothesis"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "condition": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "audioDurationSec": {
            "type": [
              "number",
              "null"
            ]
          },
          "transcribeMs": {
            "type": "number",
            "minimum": 0
          },
          "rtf": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "detectedLanguage": {
            "type": [
              "string",
              "null"
            ]
          },
          "languageProbability": {
            "type": [
              "number",
              "null"
            ]
          },
          "hypothesis": {
            "type": "string"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "scores": {
            "type": [
              "object",
              "null"
            ]
          },
          "memoryAfter": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "validated",
        "rejected",
        "inconclusive"
      ],
      "description": "Válido apenas para o ambiente registrado."
    },
    "verdictReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "catalogPromotion": {
      "type": "object",
      "required": [
        "eligible",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "eligible": {
          "type": "boolean",
          "description": "true somente com environment=windows-reference-machine, status=completed e verdict=validated. Override de ambiente nunca promove."
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "maxSamples",
        "maxBytes",
        "enforced"
      ],
      "additionalProperties": false,
      "properties": {
        "maxSamples": {
          "type": "integer",
          "maximum": 10
        },
        "maxBytes": {
          "type": "integer",
          "maximum": 104857600
        },
        "enforced": {
          "const": true
        }
      }
    },
    "status": {
      "enum": [
        "completed",
        "error"
      ],
      "description": "completed = medição; error = falha registrada, sem evidência."
    },
    "error": {
      "type": "object",
      "required": [
        "stage",
        "type",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "manifest",
            "python",
            "weights",
            "download",
            "runtime",
            "unknown"
          ]
        },
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "samples": {
            "minItems": 1
          },
          "summary": {
            "properties": {
              "sampleCount": {
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "catalogPromotion": {
            "properties": {
              "eligible": {
                "const": false
              }
            }
          },
          "samples": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
