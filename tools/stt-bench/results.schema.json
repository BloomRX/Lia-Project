{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/BloomRX/Lia-Project/tools/stt-bench/results.schema.json",
  "title": "Resultado da bancada STT da Lia",
  "description": "Saída de stt_bench.py. Um resultado descreve UMA execução em UM ambiente. Não é transferível entre máquinas.",
  "type": "object",
  "required": [
    "schema", "runId", "generatedAt", "environment", "plumbingOnly",
    "machine", "runtime", "weights", "dataset", "summary", "samples",
    "verdict", "verdictReasons", "catalogPromotion", "warnings", "limits"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "lia.stt-bench.result/v1" },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "string",
      "enum": ["arena-linux", "windows-reference-machine", "windows-other", "macos-other", "linux-other"],
      "description": "Classificado por detecção. Nenhum resultado Linux vale como medição da máquina de referência."
    },
    "plumbingOnly": {
      "type": "boolean",
      "description": "true quando veio de --self-test: valida o encanamento, não a qualidade."
    },
    "machine": {
      "type": "object",
      "required": ["os", "architecture", "cpuName", "totalRamBytes", "gpuName"],
      "additionalProperties": true,
      "properties": {
        "os": { "type": "string" },
        "osRelease": { "type": "string" },
        "osVersion": { "type": "string" },
        "architecture": { "type": "string" },
        "python": { "type": "string" },
        "cpuName": { "type": "string" },
        "cpuCount": { "type": ["integer", "null"] },
        "totalRamBytes": { "type": ["integer", "null"] },
        "totalRamGb": { "type": ["number", "null"] },
        "gpuName": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["id", "backend", "computeType", "language", "dependencies"],
      "additionalProperties": true,
      "properties": {
        "id": { "const": "faster-whisper" },
        "backend": { "const": "cpu" },
        "computeType": { "type": "string" },
        "language": { "type": "string" },
        "beamSize": { "type": "integer", "minimum": 1 },
        "vadFilter": { "type": "boolean" },
        "cpuThreads": { "type": "integer", "minimum": 0 },
        "python": { "type": "string" },
        "dependencies": {
          "type": "object",
          "description": "Versões efetivamente instaladas. Sem isto o resultado não é reproduzível.",
          "additionalProperties": { "type": ["string", "null"] }
        }
      }
    },
    "weights": {
      "type": "object",
      "required": ["modelId", "revision", "declaredLicense", "present"],
      "additionalProperties": true,
      "properties": {
        "modelId": { "type": "string" },
        "revision": { "type": ["string", "null"] },
        "declaredLicense": { "type": "string" },
        "declaredSource": { "type": "string" },
        "declaredCheckedAt": { "type": "string" },
        "cacheDir": { "type": ["string", "null"] },
        "present": { "type": "boolean" },
        "modelBinBytes": { "type": ["integer", "null"] },
        "expectedModelBinBytes": { "type": ["integer", "null"] },
        "expectedModelBinSha256": { "type": ["string", "null"] },
        "sha256Verified": { "type": "boolean" },
        "sha256Note": { "type": "string" }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["datasetId", "license", "sampleCount", "totalBytes"],
      "additionalProperties": true,
      "properties": {
        "datasetId": { "type": "string" },
        "license": { "type": "string" },
        "source": { "type": "string" },
        "sampleCount": { "type": "integer", "minimum": 1, "maximum": 10 },
        "totalBytes": { "type": "integer", "maximum": 104857600 },
        "totalMb": { "type": "number" },
        "withReference": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": ["sampleCount", "totalAudioSec"],
      "additionalProperties": true,
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 1 },
        "samplesWithReference": { "type": "integer", "minimum": 0 },
        "totalAudioSec": { "type": "number", "minimum": 0 },
        "meanAudioSec": { "type": ["number", "null"] },
        "modelLoadMs": { "type": ["number", "null"] },
        "firstTranscribeMs": { "type": ["number", "null"] },
        "transcribeMsMedian": { "type": ["number", "null"] },
        "transcribeMsP95": { "type": ["number", "null"] },
        "rtfMedian": { "type": ["number", "null"] },
        "rtfP95": { "type": ["number", "null"] },
        "peakRssBytes": { "type": ["integer", "null"] },
        "peakRssMb": { "type": ["number", "null"] },
        "corpusWer": { "type": ["number", "null"], "minimum": 0 },
        "corpusWerAccentInsensitive": { "type": ["number", "null"], "minimum": 0 },
        "corpusCer": { "type": ["number", "null"], "minimum": 0 },
        "exactMatchRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "file", "bytes", "transcribeMs", "hypothesis"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 1 },
          "condition": { "type": "string" },
          "speaker": { "type": "string" },
          "license": { "type": "string" },
          "audioDurationSec": { "type": ["number", "null"] },
          "transcribeMs": { "type": "number", "minimum": 0 },
          "rtf": { "type": ["number", "null"], "minimum": 0 },
          "detectedLanguage": { "type": ["string", "null"] },
          "languageProbability": { "type": ["number", "null"] },
          "hypothesis": { "type": "string" },
          "reference": { "type": ["string", "null"] },
          "scores": {
            "type": ["object", "null"],
            "properties": {
              "referenceWords": { "type": "integer", "minimum": 0 },
              "hypothesisWords": { "type": "integer", "minimum": 0 },
              "substitutions": { "type": "integer", "minimum": 0 },
              "deletions": { "type": "integer", "minimum": 0 },
              "insertions": { "type": "integer", "minimum": 0 },
              "editDistance": { "type": "integer", "minimum": 0 },
              "wer": { "type": ["number", "null"], "minimum": 0 },
              "werAccentInsensitive": { "type": ["number", "null"], "minimum": 0 },
              "referenceChars": { "type": "integer", "minimum": 0 },
              "cer": { "type": ["number", "null"], "minimum": 0 },
              "exactMatch": { "type": "boolean" }
            }
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["validated", "rejected", "inconclusive"],
      "description": "Válido apenas para o ambiente registrado."
    },
    "verdictReasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "catalogPromotion": {
      "type": "object",
      "required": ["eligible", "reason"],
      "additionalProperties": false,
      "properties": {
        "eligible": {
          "type": "boolean",
          "description": "true somente com environment=windows-reference-machine e verdict=validated."
        },
        "reason": { "type": "string" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "limits": {
      "type": "object",
      "required": ["maxSamples", "maxBytes", "enforced"],
      "additionalProperties": false,
      "properties": {
        "maxSamples": { "type": "integer", "maximum": 10 },
        "maxBytes": { "type": "integer", "maximum": 104857600 },
        "enforced": { "const": true }
      }
    }
  }
}
