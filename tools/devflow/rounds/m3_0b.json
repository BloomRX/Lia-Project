{
  "schema_version": 2,
  "round": {
    "id": "M3.0b",
    "title": "Pre-requisito de build gerenciado do Stage (core-agent/dist)",
    "phase": "8.0D-M3.0b",
    "ready_for_publish": false,
    "tested_sha": null
  },
  "git": {
    "expected_branch": "arena/01a10290-lia-project"
  },
  "prepare": [
    {
      "kind": "remove_generated",
      "path": "airi/packages/core-agent/dist",
      "why": "Reproduz o estado de um pull fresco: dist e gitignored, entao remove-lo forca o pre-requisito gerenciado a reconstruir do zero em vez de herdar um artefato ja pronto."
    }
  ],
  "cleanup_profile": {
    "id": "core-agent-dist-only",
    "allowlisted_generated": [
      "airi/packages/core-agent/dist"
    ]
  },
  "tests": [
    {
      "id": "devflow",
      "label": "DevFlow (contrato da rodada, limpeza segura, gate de log)",
      "cwd": ".",
      "argv": [
        "python",
        "tools/test_lia_dev.py"
      ]
    },
    {
      "id": "lia-app",
      "label": "Lia App (manager + pre-requisito + ownership + autorun)",
      "cwd": "airi/apps/lia-app",
      "argv": [
        "node",
        "../../node_modules/vitest/vitest.mjs",
        "run"
      ]
    },
    {
      "id": "stage-m30a",
      "label": "Contrato manual dev:tamagotchi (8.0D-M3.0a)",
      "cwd": "airi/apps/stage-tamagotchi",
      "argv": [
        "node",
        "../../node_modules/vitest/vitest.mjs",
        "run",
        "--project",
        "node",
        "src/main/dev-build-contract.test.ts"
      ]
    },
    {
      "id": "stage-devflow",
      "label": "Diagnostico DEVFLOW do Stage (renderer, janela, cena montada)",
      "cwd": "airi/apps/stage-tamagotchi",
      "argv": [
        "node",
        "../../node_modules/vitest/vitest.mjs",
        "run",
        "src/main/devflow-diagnostics.test.ts"
      ]
    }
  ],
  "launch": {
    "kind": "managed-launcher",
    "command": [
      "Lia.bat"
    ],
    "operator_hint": "Nada a fazer. A rodada abre o Launcher, aciona Conversar sozinha e lê a propria evidencia. Nao rode nenhum build manual: a rodada precisa provar que o Launcher reconstruiu o core-agent sozinho.",
    "env": {
      "LIA_DEVFLOW_AUTORUN": "conversar",
      "LIA_DEVFLOW_DIAGNOSTICS": "1"
    },
    "auto_action": "conversar"
  },
  "scenario": {
    "driver": "autorun",
    "steps": [
      "conversar"
    ]
  },
  "runtime_assertions": {
    "ordered_markers": [
      {
        "id": "autorun-invoked",
        "pattern": "lia-devflow autorun=invoked",
        "also": "action=conversar"
      },
      {
        "id": "prerequisite-starting",
        "pattern": "stage-prerequisite name=core-agent-build state=starting"
      },
      {
        "id": "prerequisite-succeeded",
        "pattern": "stage-prerequisite name=core-agent-build state=succeeded",
        "also": "reason=build-succeeded"
      },
      {
        "id": "stage-spawn",
        "pattern": "spawn: node",
        "also": "electron-vite.js dev"
      }
    ],
    "terminal_markers": [
      {
        "id": "stage-renderer-ready",
        "pattern": "lia-stage renderer=ready"
      },
      {
        "id": "stage-window-visible",
        "pattern": "lia-stage window=visible"
      },
      {
        "id": "stage-renderer-app-mounted",
        "pattern": "lia-stage renderer-app=mounted"
      },
      {
        "id": "stage-avatar-scene-mounted",
        "pattern": "lia-stage avatar-scene=mounted"
      }
    ],
    "forbidden_markers": [
      {
        "id": "prerequisite-failed",
        "pattern": "stage-prerequisite name=core-agent-build state=failed"
      },
      {
        "id": "autorun-failed",
        "pattern": "lia-devflow autorun=failed"
      }
    ],
    "optional_markers": [
      {
        "id": "stage-dev-server-ready",
        "pattern": "ready in"
      }
    ]
  },
  "manual_assertions": [],
  "retention": {
    "keep_runs": 20,
    "max_age_days": 30
  }
}
