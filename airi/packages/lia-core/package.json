{
  "name": "@lia/core",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Lia product core: canonical paths, product config, voice profiles, secret vault, engine-neutral voice service - independent of AIRI (Phase 7).",
  "exports": {
    ".": "./dist/index.mjs",
    "./bootstrap/runtime-root": "./dist/bootstrap/runtime-root.mjs",
    "./bridge/lia-config": "./dist/bridge/lia-config.mjs",
    "./voice/config": "./dist/voice/config.mjs",
    "./voice/engines/kokoro": "./dist/voice/engines/kokoro/index.mjs",
    "./voice/engines/registry": "./dist/voice/engines/registry.mjs",
    "./voice/engines/types": "./dist/voice/engines/types.mjs",
    "./voice/voice-service": "./dist/voice/voice-service.mjs",
    "./paths/product-paths": "./dist/paths/product-paths.mjs",
    "./paths/install-location": "./dist/paths/install-location.mjs",
    "./product/config": "./dist/product/config.mjs",
    "./secrets/vault": "./dist/secrets/vault.mjs",
    "./voice/shared": "./dist/voice/shared.mjs",
    "./voices/profiles": "./dist/voices/profiles.mjs",
    "./voices/types": "./dist/voices/types.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moeru/std": "catalog:",
    "destr": "catalog:",
    "yauzl": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/yauzl": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
