    "./alltalk/shutdown": "./dist/alltalk/shutdown.mjs",
    "./bootstrap/archive-path": "./dist/bootstrap/archive-path.mjs",
    "./bootstrap/bootstrap": "./dist/bootstrap/bootstrap.mjs",
    "./bootstrap/env": "./dist/bootstrap/env.mjs",
