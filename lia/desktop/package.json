{
  "name": "@lia/lia-app",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "The Lia launcher: the independent product shell of Lia (Phase 7). Owns product config, managed runtimes and the AIRI stage lifecycle. Boots with zero AIRI imports.",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "pnpm run build:core && electron-vite build",
    "dev": "pnpm run build:core && install-electron && electron-vite dev",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:core": "pnpm --dir ../runtime install --frozen-lockfile --ignore-scripts && pnpm --dir ../runtime run build"
  },
  "dependencies": {
    "@lia/core": "link:../runtime",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/browser-playwright": "4.1.11",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-browser-vue": "2.1.0"
  },
  "packageManager": "pnpm@11.24.0"
}
